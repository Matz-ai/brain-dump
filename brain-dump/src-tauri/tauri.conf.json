{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Brain Dump",
  "version": "0.4.1",
  "identifier": "com.brain-dump.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Brain Dump",
        "width": 900,
        "height": 600,
        "minWidth": 700,
        "minHeight": 500,
        "resizable": true,
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "visible": false,
        "theme": "Light"
      }
    ],
    "macOSPrivateApi": true,
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEVEQzI2QjAyMUFFQUMwQUEKUldTcXdPb2FBbXZDN1Y0M3h6NnhWWUlsMmx6dzc0OUdmWm1PUnRZZFFSQlJVSzlNa2hUbUEydXAK",
      "endpoints": [
        "https://github.com/Matz-ai/brain-dump/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
